MEMORY {
    FLASH    : ORIGIN = 0x0010C000, LENGTH = 32K
    RAM      : ORIGIN = 0x20114000, LENGTH = 32K
    APP      : ORIGIN = 0x00020000, LENGTH = 944K
    ROM_TABLE (r): ORIGIN = 0x1303F000, LENGTH = 64
}

SECTIONS {
    .rom_table ORIGIN(ROM_TABLE) (NOLOAD): {
        API_TABLE = .;
        . += LENGTH(ROM_TABLE);
    } >ROM_TABLE
} INSERT AFTER .uninit;
